# =============================================================================
# Agent Studio – Environment variables (copy to .env and fill in)
# =============================================================================
# .env is gitignored. Never commit real keys.
# -----------------------------------------------------------------------------
# FRONTEND (Vercel) – used at build time. Prefix with VITE_ to expose to client.
# -----------------------------------------------------------------------------
# Base URL of your Railway API (no trailing slash). Required for production.
# Example: https://your-app-name.railway.app
# VITE_API_URL=

# -----------------------------------------------------------------------------
# BACKEND (Railway) – server only. Do not use VITE_ prefix.
# -----------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins (your Vercel URL and previews).
# Example: https://your-app.vercel.app,https://*.vercel.app
# If unset, CORS allows all origins (development only).
# CORS_ORIGIN=

# Optional: port for the server (Railway sets PORT automatically).
# PORT=3001

# Optional: path to SQLite database file (e.g. on Railway mount a volume at /data and set to /data/agent-studio.db).
# DATABASE_PATH=

# Optional: seed OpenRouter API key in settings on first run (not required if set via UI).
# OPENROUTER_API_KEY=

# Optional: seed search API key (Exa/Brave/Tavily) in settings on first run.
# SEARCH_API_KEY=

# -----------------------------------------------------------------------------
# Auth & sync (optional – when set, login is required and data is per-user).
# -----------------------------------------------------------------------------
# Secret for signing JWTs (min 32 chars). When unset, app runs in local mode:
# no login is required; everyone uses the single default user (local@localhost).
# In production, set this to enforce login.
# JWT_SECRET=

# Key for encrypting sensitive settings and MCP credentials at rest (min 32 chars).
# Required before MCP server configurations can be created, changed, or imported.
# ENCRYPTION_KEY=

# Set to true or 1 to disable login/register (local mode) even if JWT_SECRET is set.
# DISABLE_AUTH=

# Backend-hosted MCP stdio is disabled by default. Prefer the paired-PC relay.
# Enable only for a trusted single-user deployment after reviewing the risk.
# MCP_ALLOW_BACKEND_STDIO=false

# Optional MCP scaling thresholds (safe defaults are built in).
# MCP_CONNECT_CONCURRENCY=4
# MCP_PROGRESSIVE_TOOL_THRESHOLD=20
# MCP_PROGRESSIVE_SCHEMA_TOKEN_THRESHOLD=3000
# MCP_HTTP_RESPONSE_MAX_BYTES=16777216

# Optional: password for initial admin (pablomiguelargudo@gmail.com) on first deploy. If unset, a random password is generated and printed in server logs.
# INITIAL_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# ChatGPT provider (Codex app-server)
# -----------------------------------------------------------------------------
# Comma-separated emails allowed to link their ChatGPT account and use GPT models
# with their ChatGPT plan's included usage. Empty = feature disabled for everyone.
# CODEX_ALLOWED_EMAILS=
# Optional: root directory for per-user Codex homes (auth.json/config.toml/threads).
# Defaults to a `codex/` folder next to the SQLite DB (e.g. /data/codex with DATABASE_PATH=/data/agent-studio.db).
# CODEX_HOME_ROOT=
# Optional: idle timeout for per-user app-server processes in ms (default 1800000 = 30 min).
# CODEX_IDLE_TIMEOUT_MS=
# Optional: wall-clock budget for one ChatGPT turn in ms (default 300000).
# CODEX_TURN_TIMEOUT_MS=

# -----------------------------------------------------------------------------
# llama.cpp provider (local models served by a user-run llama-server process,
# spawned/supervised on your PC through the paired local agent).
# Configure per user in Settings → LlamaCpp; the env vars below are FALLBACKS
# used when a setting is not saved (precedence: setting > env > default).
# -----------------------------------------------------------------------------
# Absolute path to the llama-server executable. NO default — start fails with a
# clear error while unset (e.g. C:\Users\you\AppData\Local\Programs\llamacpp\b10612\llama-server.exe).
# LLAMACPP_EXE_PATH=

# Absolute path to the directory holding your .gguf models. NO default.
# Split-shard files (-00001-of-00002.gguf) collapse into one catalog entry.
# LLAMACPP_MODELS_DIR=

# Port llama-server binds (default 8712). Always passed explicitly at spawn —
# never rely on the binary's own default.
# LLAMACPP_PORT=8712

# Minutes of idle before the loaded model is stopped automatically (default 45; 0 = off).
# LLAMACPP_IDLE_UNLOAD_MINUTES=45

# Comma-separated host:port list the paired local agent may fetch from on your behalf.
# Loopback entries for the RESOLVED llamacpp port (127.0.0.1:<port>, localhost:<port>,
# [::1]:<port>) are allowed in addition to whatever is listed here.
# SECURITY: never widen this without understanding SSRF — every entry becomes agent-reachable.
# AGENT_HTTP_PROXY_ALLOW_HOSTS=
